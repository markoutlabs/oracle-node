// One listed feed.
type FeedInfo = record {
  // The 32-byte feed id: keccak256 of the symbol.
  feed_id : blob;
  // The canonical symbol, such as `CRYPTO.BTC/USD`.
  symbol : text;
};
// A Candid-encodable representation of an HTTP request. This struct is used by
// the `http_request` method of the HTTP Gateway Protocol's Candid interface.
// 
// # Examples
// 
// ```
// use ic_http_certification::{HttpRequest, Method};
// 
// let request = HttpRequest::builder()
// .with_method(Method::GET)
// .with_url("/")
// .with_headers(vec![("X-Custom-Foo".into(), "Bar".into())])
// .with_body(&[1, 2, 3])
// .with_certificate_version(2)
// .build();
// 
// assert_eq!(request.method(), Method::GET);
// assert_eq!(request.url(), "/");
// assert_eq!(request.headers(), &[("X-Custom-Foo".into(), "Bar".into())]);
// assert_eq!(request.body(), &[1, 2, 3]);
// assert_eq!(request.certificate_version(), Some(2));
// ```
// 
// # Helpers
// 
// There are also a number of convenience methods for quickly creating an [HttpRequest] with
// commonly used HTTP methods:
// 
// - [GET](HttpRequest::get)
// - [POST](HttpRequest::post)
// - [PUT](HttpRequest::put)
// - [PATCH](HttpRequest::patch)
// - [DELETE](HttpRequest::delete)
// 
// ```
// use ic_http_certification::HttpRequest;
// 
// let request = HttpRequest::get("/").build();
// 
// assert_eq!(request.method(), "GET");
// assert_eq!(request.url(), "/");
// ```
type HttpRequest = record {
  // HTTP request URL.
  url : text;
  // HTTP request method.
  method : text;
  // HTTP request body as an array of bytes.
  body : blob;
  // HTTP request headers.
  headers : vec record { text; text };
  // The max response verification version to use in the response's
  // certificate.
  certificate_version : opt nat16;
};
// A Candid-encodable representation of an HTTP response. This struct is used
// by the `http_request` method of the HTTP Gateway Protocol's Candid interface.
// 
// # Examples
// 
// ```
// use ic_http_certification::{HttpResponse, StatusCode};
// 
// let response = HttpResponse::builder()
// .with_status_code(StatusCode::OK)
// .with_headers(vec![("Content-Type".into(), "text/plain".into())])
// .with_body(b"Hello, World!")
// .with_upgrade(false)
// .build();
// 
// assert_eq!(response.status_code(), StatusCode::OK);
// assert_eq!(response.headers(), &[("Content-Type".into(), "text/plain".into())]);
// assert_eq!(response.body(), b"Hello, World!");
// assert_eq!(response.upgrade(), Some(false));
// ```
// 
// # Helpers
// 
// There are also a number of convenience methods for quickly creating an [HttpResponse] with
// commonly used HTTP status codes:
// 
// - [OK](HttpResponse::ok)
// - [CREATED](HttpResponse::created)
// - [NO_CONTENT](HttpResponse::no_content)
// - [MOVED_PERMANENTLY](HttpResponse::moved_permanently)
// - [TEMPORARY_REDIRECT](HttpResponse::temporary_redirect)
// - [BAD_REQUEST](HttpResponse::bad_request)
// - [UNAUTHORIZED](HttpResponse::unauthorized)
// - [FORBIDDEN](HttpResponse::forbidden)
// - [NOT_FOUND](HttpResponse::not_found)
// - [METHOD_NOT_ALLOWED](HttpResponse::method_not_allowed)
// - [TOO_MANY_REQUESTS](HttpResponse::too_many_requests)
// - [INTERNAL_SERVER_ERROR](HttpResponse::internal_server_error)
// 
// ```
// use ic_http_certification::{HttpResponse, StatusCode};
// 
// let response = HttpResponse::ok(b"Hello, World!", vec![("Content-Type".into(), "text/plain".into())]).build();
// 
// assert_eq!(response.status_code(), StatusCode::OK);
// assert_eq!(response.headers(), &[("Content-Type".into(), "text/plain".into())]);
// assert_eq!(response.body(), b"Hello, World!");
// ```
type HttpResponse = record {
  // HTTP response body as an array of bytes.
  body : blob;
  // HTTP response headers.
  headers : vec record { text; text };
  // Whether the corresponding HTTP request should be upgraded to an update
  // call.
  upgrade : opt bool;
  // HTTP response status code.
  status_code : nat16;
};
// Install arguments.
type InitArgs = record {
  // Recommended quorum.
  recommended : nat16;
  // Broadcast-key epoch for the client list. Default 60.
  epoch_secs : opt nat64;
  // Threshold ECDSA key name: `dfx_test_key` locally, `key_1` on mainnet.
  key_name : text;
  // Fewest nodes a consumer should require.
  min_nodes : nat16;
  // The feeds the canister prices, as canonical symbols. Default none.
  feeds : opt vec text;
};
// One feed's price for another canister: integers at the feed's exponent.
type PriceRecord = record {
  // How much to trust the price.
  status : PriceStatus;
  // The spread between the nodes, in basis points of the price.
  spread_bps : opt text;
  // The confidence half-width, as a mantissa.
  conf : opt nat64;
  // The decimal exponent of `price` and `conf`.
  expo : int32;
  // The 32-byte feed id: keccak256 of the symbol.
  feed_id : blob;
  // Why the price is not `Ok`, such as `insufficient_nodes`.
  concerns : vec text;
  // The freshest contributing publish time, unix nanoseconds.
  publish_time_ns : nat64;
  // Nodes that contributed.
  nodes : nat32;
  // Nodes that reported the feed halted.
  halted_nodes : nat32;
  // The median of the nodes, as a mantissa: price × 10^-expo.
  price : opt int64;
  // When the canister resolved the price, unix nanoseconds.
  resolved_at_ns : nat64;
  // The canonical symbol, such as `CRYPTO.BTC/USD`.
  symbol : text;
};
// How much to trust a price, in Candid.
type PriceStatus = variant {
  // Enough nodes agree.
  Ok;
  // Usable, but act on `conf`.
  Degraded;
  // Not usable.
  Halted;
};
type Result = variant { Ok : nat64; Err : text };
type Result_1 = variant { Ok : vec Verdict; Err : text };
type Result_2 = variant { Ok : text; Err : text };
type Result_3 = variant { Ok; Err : text };
// What `push` did with one frame.
type Verdict = variant {
  // Malformed, or a signature that is not valid.
  Invalid;
  // The feed is not on the canister's list.
  UnknownFeed;
  // More than 10 s ahead of the canister's clock.
  FromTheFuture;
  // Stored as the node's latest frame for its feed.
  Accepted;
  // Observed after it was published.
  Incoherent;
  // No registry is published yet.
  NoRegistry;
  // The signer is not a listed node.
  UnknownSigner;
  // The signer is a key that the registry retired.
  RetiredKey;
  // Published more than 30 s ago.
  TooOld;
  // The sequence does not advance: the frame or a newer one is stored.
  Replayed;
};
service : (InitArgs) -> {
  // Governance authorises a client: the address of its secp256k1 API key.
  // Returns the new client-list version.
  add_client : (text, nat64) -> (Result);
  // Governance lists a node. `entry_json` is the operator's `NodeEntry`.
  // Returns the new version.
  add_node : (text) -> (Result);
  // The last published client list as JSON, if any.
  get_clients : () -> (opt text) query;
  // The listed feeds: the 32-byte id and the symbol of each.
  get_feeds : () -> (vec FeedInfo) query;
  // The governance address, once the threshold key has been fetched.
  get_governance : () -> (opt text) query;
  // When a node address was listed, as JSON, for stored-frame verification.
  get_node_listing : (text) -> (opt text) query;
  // One feed's price, resolved now, by its 32-byte feed id.
  get_price : (blob) -> (opt PriceRecord) query;
  // How long a node's latest update counts toward the quorum, in seconds.
  get_price_window : () -> (nat64) query;
  // Every listed feed's price, resolved now.
  get_prices : () -> (vec PriceRecord) query;
  // The last published registry document as JSON, if any.
  get_registry : () -> (opt text) query;
  // The version of the last published document. Zero before the first.
  get_version : () -> (nat64) query;
  // Serves `/registry.json`, `/clients.json`, `/prices.json`, `/frames.json`,
  // and a 404 for every other path, as certified query responses.
  http_request : (HttpRequest) -> (HttpResponse) query;
  // A node pushes its latest updates as one batch, or as single frames.
  // Returns one verdict for each update, in order.
  push : (vec blob) -> (Result_1);
  // Fetches the threshold public key if it is not cached. Returns the
  // governance address consumers pin.
  refresh_governance_key : () -> (Result_2);
  // Governance revokes a client. Returns the new client-list version.
  remove_client : (text) -> (Result);
  // Governance de-lists a node. Returns the new version.
  remove_node : (text) -> (Result);
  // Governance rotates a node's key: the `new` address takes the place of
  // `old`, with the same endpoints and weight. Returns the new version.
  replace_node : (text, text) -> (Result);
  // Governance re-signs the registry with no change. Returns the new version.
  republish : () -> (Result);
  // Governance re-signs the client list with no change, for example to publish
  // an empty list before the first client. Returns the new client-list version.
  republish_clients : () -> (Result);
  // Governance moves a client's expiry. Returns the new client-list version.
  set_client_expiry : (text, nat64) -> (Result);
  // Governance sets the feeds that the canister prices, as canonical symbols.
  // A feed that stays keeps its frames.
  set_feeds : (vec text) -> (Result_3);
  // Governance sets how long a node's latest update counts toward the quorum,
  // in seconds. About three push intervals: 25 for pushes every 7 s.
  set_price_window : (nat64) -> (Result_3);
  // Governance changes the quorum guidance. Returns the new version.
  set_quorum : (nat16, nat16) -> (Result);
}
