{
  "canisters": {
    "oracle_registry": {
      "type": "custom",
      "package": "oracle-registry-canister",
      "build": "cargo build -p oracle-registry-canister --target wasm32-unknown-unknown --release",
      "wasm": "target/wasm32-unknown-unknown/release/oracle_registry_canister.wasm",
      "candid": "crates/oracle-registry-canister/oracle-registry-canister.did",
      "metadata": [{ "name": "candid:service" }]
    }
  },
  "defaults": {
    "build": {
      "packtool": ""
    }
  },
  "output_env_file": ".env",
  "version": 1
}
